<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<title>黑客松日报 - {{ today }}（今日无新增）</title>
<style type="text/css">
  /* 收敛版：酸性色强调 + 等宽标签，去掉故障投影 / 背景网格 / 硬阴影 / 超大展示字。 */
  @media (prefers-color-scheme: dark) {
    body, .outer { background-color: #0B0F1E !important; }
    .card, .stats-bar { background-color: #141A2E !important; border-color: #2A3358 !important; }
    .brand-title, .empty-title, .card-title { color: #F0EFEB !important; }
    .brand-meta, .empty-msg, .meta-label, .footer { color: #A0A8C8 !important; }
  }
  @media (prefers-color-scheme: light) {
    body, .outer { background-color: #F0EFEB !important; }
    .card, .stats-bar { background-color: #FFFFFF !important; border-color: #E2E4E0 !important; }
    .brand-title, .empty-title, .card-title { color: #16181D !important; }
    .brand-meta, .empty-msg, .meta-label, .footer { color: #5C6270 !important; }
  }
</style>
</head>
<body class="outer" bgcolor="#F0EFEB" style="margin: 0; padding: 0; background-color: #F0EFEB; font-family: 'Space Grotesk', 'Trebuchet MS', 'Segoe UI', sans-serif; font-size: 14px; color: #16181D; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: 100%;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #F0EFEB;">
<tr>
<td align="center" style="padding: 24px 12px;">

<!-- Main content area: 600px max, centered -->
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; width: 100%; margin: 0 auto;">

<!-- ==================== HEADER ==================== -->
<tr>
<td style="padding: 0 0 14px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td width="44" valign="top" style="padding-right: 14px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td width="44" height="44" bgcolor="#D4FF00" align="center" valign="middle" style="background-color: #D4FF00; border: 1px solid #16181D; border-radius: 6px; width: 44px; height: 44px; text-align: center; vertical-align: middle; font-family: 'Space Grotesk', 'Trebuchet MS', sans-serif; font-size: 15px; font-weight: 700; color: #16181D;">HD</td>
      </tr>
      </table>
    </td>
    <td valign="top">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td class="brand-title" style="padding: 0 0 5px 0; font-family: 'Space Grotesk', 'Trebuchet MS', sans-serif; font-size: 22px; font-weight: 700; color: #16181D; line-height: 1.15;">黑客松日报</td>
      </tr>
      <tr>
        <td class="brand-meta" style="padding: 0; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; color: #5C6270; letter-spacing: 0.08em; text-transform: uppercase;">{{ today }} &middot; 今日无新增</td>
      </tr>
      </table>
    </td>
  </tr>
  </table>
</td>
</tr>

<tr>
<td style="padding: 0 0 22px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td style="height: 3px; font-size: 0; line-height: 0; background-color: #D4FF00;">&nbsp;</td></tr>
  </table>
</td>
</tr>

<!-- ==================== EMPTY STATE ==================== -->
<tr>
<td style="padding: 0 0 24px 0;">
  <table class="stats-bar" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#FFFFFF" style="background-color: #FFFFFF; border: 1px solid #E2E4E0; border-top: 3px solid #D4FF00; border-radius: 8px; border-collapse: separate;">
  <tr>
    <td align="center" style="padding: 30px 20px;">
      <div style="font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; color: #5C6270; letter-spacing: 0.2em; text-transform: uppercase;">STATUS / 00</div>
      <div class="empty-title" style="padding-top: 12px; font-family: 'Fraunces', Georgia, 'Times New Roman', serif; font-size: 28px; font-style: italic; color: #16181D; line-height: 1.2;">今日无新增</div>
      <div class="empty-msg" style="padding-top: 10px; font-size: 13px; color: #5C6270; line-height: 1.65;">今天没有发现新的可报名黑客松，明天见。</div>
      <div class="meta-label" style="padding-top: 14px; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; color: #5C6270; letter-spacing: 0.08em; text-transform: uppercase;">本周累计 {{ weekly_count }} 场</div>
    </td>
  </tr>
  </table>
</td>
</tr>

<!-- ==================== UPCOMING TOP3 ==================== -->
{% if top %}
<tr>
<td style="padding: 0 0 12px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="group-head" style="padding: 8px 12px; border-left: 4px solid #D4FF00; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 12px; font-weight: 700; color: #16181D; letter-spacing: 0.06em; text-transform: uppercase;">⏳ 即将截止 TOP3</td>
  </tr>
  </table>
</td>
</tr>

{% for h in top %}
{% set u = h.urgency() %}
{% set dl = h.days_left %}
<tr>
<td style="padding: 0 0 14px 0;">
  <table class="card" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#FFFFFF" style="background-color: #FFFFFF; border: 1px solid #E2E4E0; border-radius: 8px; border-collapse: separate;">
  <tr>
  <td style="padding: 14px 18px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td class="card-title" style="padding: 0; font-family: 'Space Grotesk', 'Trebuchet MS', sans-serif; font-size: 15px; font-weight: 700; color: #16181D; line-height: 1.3;">{{ h.name }}</td>
      <td align="right" style="padding: 0 0 0 10px; white-space: nowrap;">
        {% if u == 'hot' %}
        <span style="display: inline-block; padding: 3px 7px; background-color: #FFE3D6; border-radius: 4px; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; font-weight: 700; color: #A63600;">{% if dl < 0 %}已截止{% elif dl == 0 %}今天截止{% else %}剩 {{ dl }} 天{% endif %}</span>
        {% elif u == 'soon' %}
        <span style="display: inline-block; padding: 3px 7px; background-color: #EEFFA8; border-radius: 4px; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; font-weight: 700; color: #3D4A00;">剩 {{ dl }} 天</span>
        {% elif u == 'later' %}
        <span style="display: inline-block; padding: 3px 7px; background-color: #E3F7E8; border-radius: 4px; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; font-weight: 700; color: #1E6B33;">{{ dl }} 天后</span>
        {% else %}
        <span style="display: inline-block; padding: 3px 7px; background-color: #EEEFE9; border-radius: 4px; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; font-weight: 700; color: #555B66;">待定</span>
        {% endif %}
      </td>
    </tr>
    </table>
    <div class="meta-label" style="padding-top: 9px; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; color: #5C6270; letter-spacing: 0.06em;">报名截止 {{ h.registration_deadline }}</div>
    {% if h.register_link %}
    <a href="{{ h.register_link | safe_url }}" target="_blank" style="display: inline-block; margin-top: 11px; padding: 8px 18px; background-color: #D4FF00; border: 1px solid #D4FF00; border-radius: 6px; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; font-weight: 700; color: #16181D; text-decoration: none; letter-spacing: 0.04em;">立即报名 &rarr;</a>
    {% endif %}
  </td>
  </tr>
  </table>
</td>
</tr>
{% endfor %}
{% endif %}

<!-- ==================== FOOTER ==================== -->
<tr>
<td style="padding: 16px 0 0 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td style="padding: 0; border-top: 1px solid #E2E4E0; font-size: 0; line-height: 0;">&nbsp;</td></tr>
  <tr>
    <td class="footer" style="padding: 14px 0 0 0; text-align: center; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; color: #5C6270; letter-spacing: 0.06em; line-height: 1.6;">
      本邮件由 Hackathon Daily 自动推送 &middot; {{ today }}
    </td>
  </tr>
  </table>
</td>
</tr>

</table>
<!-- End main content -->

</td>
</tr>
</table>
<!-- End outer wrapper -->

</body>
</html>
