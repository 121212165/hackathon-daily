<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<title>黑客松日报 - {{ today }}</title>
<style type="text/css">
  <!-- 邮件客户端不支持外部 CSS；内联样式为兜底，@media 用 !important 覆盖内联样式兼容明暗模式。 -->
  @media (prefers-color-scheme: dark) {
    body, .outer { background-color: #0f0f10 !important; }
    .card { background-color: #111112 !important; border-color: #303136 !important; }
    .stats-bar { background-color: #16171a !important; border-color: #303136 !important; }
    .brand-title, .card-title, .info-val, .group-head { color: #f4f9ff !important; }
    .brand-meta, .card-org, .info-label, .footer, .group-count { color: #a0a4b0 !important; }
    .card-summary { color: #c8cdd6 !important; }
    .btn-ghost { color: #f4f9ff !important; border-color: #303136 !important; }
  }
  @media (prefers-color-scheme: light) {
    body, .outer { background-color: #f4f5f7 !important; }
    .card { background-color: #ffffff !important; border-color: #e2e4e9 !important; }
    .stats-bar { background-color: #ffffff !important; border-color: #e2e4e9 !important; }
    .brand-title, .card-title, .info-val, .group-head { color: #1a1c20 !important; }
    .brand-meta, .card-org, .info-label, .footer, .group-count { color: #5c6270 !important; }
    .card-summary { color: #3f4452 !important; }
    .btn-ghost { color: #1a1c20 !important; border-color: #d8dae0 !important; }
  }
</style>
</head>
<body class="outer" bgcolor="#0f0f10" style="margin: 0; padding: 0; background-color: #0f0f10; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 14px; color: #f4f9ff; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: 100%;">

<!-- Outer wrapper -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #0f0f10;">
<tr>
<td align="center" style="padding: 32px 16px;">

<!-- Main content area: 600px max, centered -->
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; width: 100%; margin: 0 auto;">

<!-- ==================== HEADER ==================== -->
<tr>
<td style="padding: 0 0 20px 0;">
  <!-- Brand row -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <!-- Brand mark -->
    <td width="48" valign="top" style="padding-right: 16px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td width="48" height="48" bgcolor="#ea343a" align="center" valign="middle" style="background-color: #ea343a; border-radius: 10px; width: 48px; height: 48px; text-align: center; vertical-align: middle; font-size: 20px; font-weight: 700; color: #ffffff; letter-spacing: -0.5px; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;">
          HD
        </td>
      </tr>
      </table>
    </td>
    <!-- Title block -->
    <td valign="top">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td class="brand-title" style="padding: 0 0 6px 0; font-size: 24px; font-weight: 700; color: #f4f9ff; line-height: 1.2;">
          黑客松日报
        </td>
      </tr>
      <tr>
        <td class="brand-meta" style="padding: 0; font-size: 12px; color: #a0a4b0; font-family: 'SF Mono', 'Roboto Mono', Consolas, monospace; letter-spacing: 0.3px;">
          {{ today }} &middot; 共 {{ count }} 场可报名
        </td>
      </tr>
      </table>
    </td>
  </tr>
  </table>
</td>
</tr>

<!-- ==================== STATS BAR ==================== -->
<tr>
<td style="padding: 0 0 28px 0;">
  <table class="stats-bar" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#16171a" style="background-color: #16171a; border: 1px solid #303136; border-radius: 12px; border-collapse: separate;">
  <tr>
    <td align="center" width="33.33%" style="padding: 16px 8px;">
      <div class="info-val" style="font-size: 22px; font-weight: 700; color: #f4f9ff; line-height: 1.2;">{{ stats.new }}</div>
      <div class="brand-meta" style="padding-top: 4px; font-size: 12px; color: #a0a4b0;">今日新增</div>
    </td>
    <td align="center" width="33.33%" style="padding: 16px 8px; border-left: 1px solid #303136;">
      <div style="font-size: 22px; font-weight: 700; color: #ea343a; line-height: 1.2;">{{ stats.hot }}</div>
      <div class="brand-meta" style="padding-top: 4px; font-size: 12px; color: #a0a4b0;">即将截止</div>
    </td>
    <td align="center" width="33.33%" style="padding: 16px 8px; border-left: 1px solid #303136;">
      <div class="info-val" style="font-size: 22px; font-weight: 700; color: #f4f9ff; line-height: 1.2;">{{ stats.week }}</div>
      <div class="brand-meta" style="padding-top: 4px; font-size: 12px; color: #a0a4b0;">本周累计</div>
    </td>
  </tr>
  </table>
</td>
</tr>

<!-- ==================== EMPTY STATE ==================== -->
{# 空日邮件由 main.py 走 empty.html.j2；此分支仅作防御性渲染。 #}
{% if not hackathons %}
<tr>
<td style="padding: 48px 24px; text-align: center;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td align="center" style="font-size: 15px; color: #a0a4b0; line-height: 1.6;">
      今日暂无可报名的线上黑客松。
    </td>
  </tr>
  </table>
</td>
</tr>
{% endif %}

<!-- ==================== GROUPED HACKATHON CARDS ==================== -->
{% for group in groups %}
{% if group.entries %}
<!-- Group section head -->
<tr>
<td style="padding: 0 0 14px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="group-head" style="padding: 0; font-size: 16px; font-weight: 700; color: #f4f9ff;">
      {{ group.label }}
    </td>
    <td class="group-count" align="right" style="padding: 0; font-size: 12px; color: #a0a4b0;">{{ group.entries|length }} 场</td>
  </tr>
  </table>
</td>
</tr>

{% for h in group.entries %}
{% set u = h.urgency() %}
{% set dl = h.days_left %}
<tr>
<td style="padding: 0 0 20px 0;">
  <!-- Card outer -->
  <table class="card" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#111112" style="background-color: #111112; border: 1px solid #303136; border-radius: 16px; overflow: hidden; border-collapse: separate;">

  <!-- Card top spacing -->
  <tr><td style="height: 18px; font-size: 0; line-height: 0;">&nbsp;</td></tr>

  <!-- Countdown badge + type chip row -->
  <tr>
  <td style="padding: 0 24px 0 24px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td style="padding: 0;">
        {% if u == 'hot' %}
        <span class="badge badge-hot" style="display: inline-block; padding: 4px 10px; background-color: #ea343a; color: #ffffff; border-radius: 6px; font-size: 12px; font-weight: 700; letter-spacing: 0.2px;">{% if dl < 0 %}🔥 已截止{% elif dl == 0 %}🔥 今天截止{% else %}🔥 剩 {{ dl }} 天{% endif %}</span>
        {% elif u == 'soon' %}
        <span class="badge badge-soon" style="display: inline-block; padding: 4px 10px; background-color: #f5a524; color: #1a1c20; border-radius: 6px; font-size: 12px; font-weight: 700; letter-spacing: 0.2px;">⏳ 剩 {{ dl }} 天</span>
        {% elif u == 'later' %}
        <span class="badge badge-later" style="display: inline-block; padding: 4px 10px; background-color: #34c759; color: #ffffff; border-radius: 6px; font-size: 12px; font-weight: 700; letter-spacing: 0.2px;">📅 {{ dl }} 天后</span>
        {% else %}
        <span class="badge badge-unknown" style="display: inline-block; padding: 4px 10px; background-color: #6b7280; color: #ffffff; border-radius: 6px; font-size: 12px; font-weight: 700; letter-spacing: 0.2px;">⌛ 待定</span>
        {% endif %}
      </td>
      <td align="right" style="padding: 0;">
        {% if h.type_tag == 'AI' %}
        <span class="chip" style="display: inline-block; padding: 3px 10px; background-color: rgba(234,52,58,0.15); color: #ea343a; border-radius: 6px; font-size: 12px; font-weight: 500; letter-spacing: 0.3px;">{{ h.type_tag }}</span>
        {% elif h.type_tag == '全栈' %}
        <span class="chip" style="display: inline-block; padding: 3px 10px; background-color: rgba(89,56,255,0.15); color: #5938ff; border-radius: 6px; font-size: 12px; font-weight: 500; letter-spacing: 0.3px;">{{ h.type_tag }}</span>
        {% elif h.type_tag == '数据' %}
        <span class="chip" style="display: inline-block; padding: 3px 10px; background-color: rgba(148,189,255,0.15); color: #94bdff; border-radius: 6px; font-size: 12px; font-weight: 500; letter-spacing: 0.3px;">{{ h.type_tag }}</span>
        {% elif h.type_tag == '创意' %}
        <span class="chip" style="display: inline-block; padding: 3px 10px; background-color: rgba(224,112,255,0.15); color: #e070ff; border-radius: 6px; font-size: 12px; font-weight: 500; letter-spacing: 0.3px;">{{ h.type_tag }}</span>
        {% else %}
        <span class="chip" style="display: inline-block; padding: 3px 10px; background-color: rgba(160,164,176,0.15); color: #a0a4b0; border-radius: 6px; font-size: 12px; font-weight: 500; letter-spacing: 0.3px;">{{ h.type_tag }}</span>
        {% endif %}
      </td>
    </tr>
    </table>
  </td>
  </tr>

  <!-- Name row -->
  <tr>
  <td class="card-title" style="padding: 12px 24px 0 24px; font-size: 18px; font-weight: 700; color: #f4f9ff; line-height: 1.4; vertical-align: middle;">
    {{ h.name }}
  </td>
  </tr>

  <!-- Organizer -->
  <tr>
  <td class="card-org" style="padding: 6px 24px 0 24px; font-size: 13px; color: #a0a4b0;">
    {{ h.organizer }}
  </td>
  </tr>

  <!-- One-line summary -->
  {% if h.summary %}
  <tr>
  <td class="card-summary" style="padding: 10px 24px 0 24px; font-size: 14px; color: #c8cdd6; line-height: 1.7;">
    {{ h.summary }}
  </td>
  </tr>
  {% endif %}

  <!-- Info table -->
  <tr>
  <td style="padding: 14px 24px 0 24px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
    <tr>
      <td class="info-label" style="padding: 5px 0; font-size: 12px; color: #a0a4b0; font-family: 'SF Mono', 'Roboto Mono', Consolas, monospace; width: 72px; vertical-align: top;">报名截止</td>
      <td class="info-val" style="padding: 5px 0 5px 12px; font-size: 13px; color: #f4f9ff; vertical-align: top;">
        {{ h.registration_deadline }}
      </td>
    </tr>
    <tr>
      <td class="info-label" style="padding: 5px 0; font-size: 12px; color: #a0a4b0; font-family: 'SF Mono', 'Roboto Mono', Consolas, monospace; vertical-align: top;">比赛时间</td>
      <td class="info-val" style="padding: 5px 0 5px 12px; font-size: 13px; color: #f4f9ff; vertical-align: top;">{{ h.start_date }} ~ {{ h.end_date }}</td>
    </tr>
    <tr>
      <td class="info-label" style="padding: 5px 0; font-size: 12px; color: #a0a4b0; font-family: 'SF Mono', 'Roboto Mono', Consolas, monospace; vertical-align: top;">地点</td>
      <td class="info-val" style="padding: 5px 0 5px 12px; font-size: 13px; color: #f4f9ff; vertical-align: top;">{{ h.location }}</td>
    </tr>
    </table>
  </td>
  </tr>

  <!-- Buttons: 报名 / 详情 -->
  <tr>
  <td style="padding: 18px 24px 22px 24px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td style="padding: 0;">
        <a href="{{ h.registration_url | safe_url }}" target="_blank" style="display: inline-block; padding: 10px 24px; background-color: #ea343a; color: #ffffff; text-decoration: none; border-radius: 8px; font-size: 14px; font-weight: 600; letter-spacing: 0.3px;">
          立即报名
        </a>
      </td>
      {% if h.detail_url %}
      <td width="12" style="font-size: 0; line-height: 0; width: 12px;">&nbsp;</td>
      <td style="padding: 0;">
        <a class="btn-ghost" href="{{ h.detail_url | safe_url }}" target="_blank" style="display: inline-block; padding: 9px 23px; background-color: transparent; color: #f4f9ff; text-decoration: none; border: 1px solid #303136; border-radius: 8px; font-size: 14px; font-weight: 500; letter-spacing: 0.3px;">
          详情
        </a>
      </td>
      {% endif %}
    </tr>
    </table>
  </td>
  </tr>

  </table>
  <!-- Card end -->
</td>
</tr>
{% endfor %}
{% endif %}
{% endfor %}

<!-- ==================== FOOTER ==================== -->
<tr>
<td style="padding: 12px 0 0 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td style="padding: 0; border-top: 1px solid #303136; font-size: 0; line-height: 0;">&nbsp;</td></tr>
  <tr>
    <td class="footer" style="padding: 20px 0 0 0; font-size: 12px; color: #a0a4b0; text-align: center; line-height: 1.6;">
      本邮件由 Hackathon Daily 自动推送 &middot; Powered by AI Search
    </td>
  </tr>
  </table>
</td>
</tr>

</table>
<!-- End main content -->

</td>
</tr>
</table>
<!-- End outer wrapper -->

</body>
</html>
