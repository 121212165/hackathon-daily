<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<title>黑客松日报 - {{ today }}</title>
<style type="text/css">
  /* 2026 ACID-BRUTALIST SYSTEM — 内联样式为兜底，@media 用 !important 覆盖以兼容明暗模式。
     字体栈：首选小众字体，未安装时回退到气质相近的系统字体；无外部 CSS / 无弹性布局。 */
  @media (prefers-color-scheme: dark) {
    body, .outer { background-color: #0B0F1E !important; }
    .card { background-color: #141A2E !important; border-color: #0B0F1E !important; }
    .stats-bar { background-color: #380B44 !important; border-color: #D4FF00 !important; }
    .brand-title, .card-title, .info-val { color: #F0EFEB !important; }
    .brand-meta, .card-org, .info-label, .footer, .group-count, .stat-label, .ticker { color: #A0A8C8 !important; }
    .card-summary { color: #D8DCEC !important; }
    .btn-ghost { color: #D4FF00 !important; border-color: #D4FF00 !important; }
  }
  @media (prefers-color-scheme: light) {
    body, .outer { background-color: #F0EFEB !important; }
    .card { background-color: #FFFFFF !important; border-color: #0B0F1E !important; }
    .stats-bar { background-color: #D4FF00 !important; border-color: #0B0F1E !important; }
    .brand-title, .card-title, .info-val { color: #0B0F1E !important; }
    .brand-meta, .card-org, .info-label, .footer, .group-count, .stat-label, .ticker { color: #4A4A58 !important; }
    .card-summary { color: #2A2A38 !important; }
    .btn-ghost { color: #0B0F1E !important; border-color: #0B0F1E !important; }
  }
</style>
</head>
<body class="outer" bgcolor="#0B0F1E" style="margin: 0; padding: 0; background-color: #0B0F1E; background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(212,255,0,0.05) 40px), repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(212,255,0,0.05) 40px); font-family: 'Space Grotesk', 'Trebuchet MS', 'Segoe UI', sans-serif; font-size: 14px; color: #F0EFEB; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: 100%;">

<!-- Outer wrapper -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #0B0F1E;">
<tr>
<td align="center" style="padding: 24px 12px;">

<!-- Main content area: 600px max, centered -->
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; width: 100%; margin: 0 auto;">

<!-- ==================== HEADER ==================== -->
<tr>
<td style="padding: 0 0 16px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <!-- Brutalist brand mark: acid block + hard offset shadow -->
    <td width="52" valign="top" style="padding-right: 16px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td width="52" height="52" bgcolor="#D4FF00" align="center" valign="middle" style="background-color: #D4FF00; border: 2px solid #0B0F1E; box-shadow: 4px 4px 0 #FF4D00; width: 52px; height: 52px; text-align: center; vertical-align: middle; font-family: 'Unbounded', 'Arial Black', Impact, sans-serif; font-size: 18px; font-weight: 900; color: #0B0F1E; letter-spacing: -1px;">
          HD
        </td>
      </tr>
      </table>
    </td>
    <td valign="top">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <!-- Glitch-offset display type -->
        <td class="brand-title" style="padding: 0 0 4px 0; font-family: 'Unbounded', 'Arial Black', Impact, sans-serif; font-size: 26px; font-weight: 900; color: #F0EFEB; line-height: 1; letter-spacing: -1px; text-transform: uppercase; text-shadow: 2px 0 #FF4D00, -2px 0 #00FF41;">黑客松日报</td>
      </tr>
      <tr>
        <td class="brand-meta" style="padding: 0; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; color: #A0A8C8; letter-spacing: 0.12em; text-transform: uppercase;">
          {{ today }} &middot; {{ count }} EVENTS OPEN
        </td>
      </tr>
      </table>
    </td>
  </tr>
  </table>
</td>
</tr>

<!-- ==================== TYPE-AS-GRAPHIC TICKER ==================== -->
<tr>
<td style="padding: 0 0 18px 0; border-top: 2px solid #D4FF00; border-bottom: 2px solid #D4FF00;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="ticker" style="padding: 7px 0; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; color: #D4FF00; letter-spacing: 0.28em; text-transform: uppercase; white-space: nowrap; overflow: hidden;">
      HACKATHON // DAILY // 2026 // OPEN CALL // DEADLINE WATCH //
    </td>
  </tr>
  </table>
</td>
</tr>

<!-- ==================== STATS BAR ==================== -->
<tr>
<td style="padding: 0 0 26px 0;">
  <table class="stats-bar" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#380B44" style="background-color: #380B44; border: 2px solid #D4FF00; border-collapse: separate;">
  <tr>
    <td align="center" width="33.33%" style="padding: 18px 8px; border-right: 2px solid #D4FF00;">
      <div style="font-family: 'Unbounded', 'Arial Black', Impact, sans-serif; font-size: 28px; font-weight: 900; color: #D4FF00; line-height: 1;">{{ stats.new }}</div>
      <div class="stat-label" style="padding-top: 7px; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; color: #A0A8C8; letter-spacing: 0.16em; text-transform: uppercase;">今日新增</div>
    </td>
    <td align="center" width="33.33%" style="padding: 18px 8px; border-right: 2px solid #D4FF00;">
      <div style="font-family: 'Unbounded', 'Arial Black', Impact, sans-serif; font-size: 28px; font-weight: 900; color: #FF4D00; line-height: 1;">{{ stats.hot }}</div>
      <div class="stat-label" style="padding-top: 7px; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; color: #A0A8C8; letter-spacing: 0.16em; text-transform: uppercase;">即将截止</div>
    </td>
    <td align="center" width="33.33%" style="padding: 18px 8px;">
      <div style="font-family: 'Unbounded', 'Arial Black', Impact, sans-serif; font-size: 28px; font-weight: 900; color: #00FF41; line-height: 1;">{{ stats.week }}</div>
      <div class="stat-label" style="padding-top: 7px; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; color: #A0A8C8; letter-spacing: 0.16em; text-transform: uppercase;">本周累计</div>
    </td>
  </tr>
  </table>
</td>
</tr>

<!-- ==================== EMPTY STATE (defensive) ==================== -->
{% if not hackathons %}
<tr>
<td style="padding: 48px 20px; text-align: center; border: 2px solid #D4FF00;">
  <div style="font-family: 'Fraunces', Georgia, serif; font-size: 22px; font-style: italic; color: #F0EFEB;">今日暂无可报名的线上黑客松。</div>
</td>
</tr>
{% endif %}

<!-- ==================== GROUPED HACKATHON CARDS ==================== -->
{% for group in groups %}
{% if group.entries %}
<!-- Group section head: solid acid block, type as graphic -->
<tr>
<td style="padding: 0 0 16px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td bgcolor="#D4FF00" class="group-head" style="padding: 9px 12px; background-color: #D4FF00; border: 2px solid #0B0F1E; font-family: 'Unbounded', 'Arial Black', Impact, sans-serif; font-size: 15px; font-weight: 900; color: #0B0F1E; letter-spacing: -0.3px; text-transform: uppercase;">{{ group.label }}</td>
    <td bgcolor="#D4FF00" class="group-count" align="right" style="padding: 9px 12px; background-color: #D4FF00; border: 2px solid #0B0F1E; border-left: 0; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; font-weight: 700; color: #0B0F1E; white-space: nowrap;">{{ group.entries|length }} 场</td>
  </tr>
  </table>
</td>
</tr>

{% for h in group.entries %}
{% set u = h.urgency() %}
{% set dl = h.days_left %}
<tr>
<td style="padding: 0 0 22px 0;">
  <!-- Brutalist card: 2px hard border + offset shadow -->
  <table class="card" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#141A2E" style="background-color: #141A2E; border: 2px solid #0B0F1E; box-shadow: 5px 5px 0 #0B0F1E; border-collapse: separate;">

  <tr><td style="height: 18px; font-size: 0; line-height: 0;">&nbsp;</td></tr>

  <!-- Countdown badge + type chip -->
  <tr>
  <td style="padding: 0 20px 0 20px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td style="padding: 0;">
        {% if u == 'hot' %}
        <span class="badge badge-hot" style="display: inline-block; padding: 5px 10px; background-color: #FF4D00; border: 2px solid #0B0F1E; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 12px; font-weight: 700; color: #FFFFFF; text-transform: uppercase; letter-spacing: 0.06em;">{% if dl < 0 %}🔥 已截止{% elif dl == 0 %}🔥 今天截止{% else %}🔥 剩 {{ dl }} 天{% endif %}</span>
        {% elif u == 'soon' %}
        <span class="badge badge-soon" style="display: inline-block; padding: 5px 10px; background-color: #D4FF00; border: 2px solid #0B0F1E; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 12px; font-weight: 700; color: #0B0F1E; text-transform: uppercase; letter-spacing: 0.06em;">⏳ 剩 {{ dl }} 天</span>
        {% elif u == 'later' %}
        <span class="badge badge-later" style="display: inline-block; padding: 5px 10px; background-color: #00FF41; border: 2px solid #0B0F1E; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 12px; font-weight: 700; color: #0B0F1E; text-transform: uppercase; letter-spacing: 0.06em;">📅 {{ dl }} 天后</span>
        {% else %}
        <span class="badge badge-unknown" style="display: inline-block; padding: 5px 10px; background-color: #F0EFEB; border: 2px solid #0B0F1E; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 12px; font-weight: 700; color: #0B0F1E; text-transform: uppercase; letter-spacing: 0.06em;">⌛ 待定</span>
        {% endif %}
      </td>
      <td align="right" style="padding: 0 0 0 10px;">
        <span class="chip" style="display: inline-block; padding: 4px 9px; background-color: #380B44; border: 1px solid #D4FF00; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; font-weight: 700; color: #D4FF00; text-transform: uppercase; letter-spacing: 0.1em;">{{ h.type_tag }}</span>
      </td>
    </tr>
    </table>
  </td>
  </tr>

  <!-- Name: oversized display type -->
  <tr>
  <td class="card-title" style="padding: 14px 20px 0 20px; font-family: 'Unbounded', 'Arial Black', Impact, sans-serif; font-size: 21px; font-weight: 900; color: #F0EFEB; line-height: 1.1; letter-spacing: -0.6px;">{{ h.name }}</td>
  </tr>

  <!-- Organizer -->
  <tr>
  <td class="card-org" style="padding: 7px 20px 0 20px; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; color: #A0A8C8; text-transform: uppercase; letter-spacing: 0.08em;">{{ h.organizer }}</td>
  </tr>

  <!-- One-line summary -->
  {% if h.summary %}
  <tr>
  <td class="card-summary" style="padding: 11px 20px 0 20px; font-size: 14px; color: #D8DCEC; line-height: 1.65;">{{ h.summary }}</td>
  </tr>
  {% endif %}

  <!-- Info table -->
  <tr>
  <td style="padding: 15px 20px 0 20px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
    <tr>
      <td class="info-label" style="padding: 5px 0; width: 78px; vertical-align: top; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; color: #A0A8C8; text-transform: uppercase; letter-spacing: 0.1em;">报名截止</td>
      <td class="info-val" style="padding: 5px 0 5px 12px; vertical-align: top; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 13px; font-weight: 700; color: #F0EFEB;">{{ h.registration_deadline }}</td>
    </tr>
    <tr>
      <td class="info-label" style="padding: 5px 0; vertical-align: top; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; color: #A0A8C8; text-transform: uppercase; letter-spacing: 0.1em;">比赛时间</td>
      <td class="info-val" style="padding: 5px 0 5px 12px; vertical-align: top; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 13px; font-weight: 700; color: #F0EFEB;">{{ h.start_date }} ~ {{ h.end_date }}</td>
    </tr>
    <tr>
      <td class="info-label" style="padding: 5px 0; vertical-align: top; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; color: #A0A8C8; text-transform: uppercase; letter-spacing: 0.1em;">地点</td>
      <td class="info-val" style="padding: 5px 0 5px 12px; vertical-align: top; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 13px; font-weight: 700; color: #F0EFEB;">{{ h.location }}</td>
    </tr>
    </table>
  </td>
  </tr>

  <!-- Buttons: hard-edged, offset shadow -->
  <tr>
  <td style="padding: 18px 20px 22px 20px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td style="padding: 0;">
        <a href="{{ h.registration_url | safe_url }}" target="_blank" style="display: inline-block; padding: 11px 22px; background-color: #D4FF00; border: 2px solid #0B0F1E; box-shadow: 3px 3px 0 #0B0F1E; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 13px; font-weight: 700; color: #0B0F1E; text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em;">立即报名 &rarr;</a>
      </td>
      {% if h.detail_url %}
      <td width="12" style="font-size: 0; line-height: 0; width: 12px;">&nbsp;</td>
      <td style="padding: 0;">
        <a class="btn-ghost" href="{{ h.detail_url | safe_url }}" target="_blank" style="display: inline-block; padding: 10px 20px; background-color: transparent; border: 2px solid #D4FF00; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 13px; font-weight: 700; color: #D4FF00; text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em;">详情 &rarr;</a>
      </td>
      {% endif %}
    </tr>
    </table>
  </td>
  </tr>

  </table>
  <!-- Card end -->
</td>
</tr>
{% endfor %}
{% endif %}
{% endfor %}

<!-- ==================== FOOTER ==================== -->
<tr>
<td style="padding: 18px 0 0 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td style="padding: 0; border-top: 2px solid #D4FF00; font-size: 0; line-height: 0;">&nbsp;</td></tr>
  <tr>
    <td class="footer" style="padding: 16px 0 0 0; text-align: center; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; color: #A0A8C8; text-transform: uppercase; letter-spacing: 0.14em; line-height: 1.6;">
      HACKATHON DAILY &middot; AUTO-DISPATCHED BY AI SEARCH &middot; NO. {{ today }}
    </td>
  </tr>
  </table>
</td>
</tr>

</table>
<!-- End main content -->

</td>
</tr>
</table>
<!-- End outer wrapper -->

</body>
</html>
