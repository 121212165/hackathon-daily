<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<title>黑客松日报 - {{ today }}（今日无新增）</title>
<style type="text/css">
  /* 2026 ACID-BRUTALIST SYSTEM — 内联兜底 + @media !important 覆盖兼容明暗模式。 */
  @media (prefers-color-scheme: dark) {
    body, .outer { background-color: #0B0F1E !important; }
    .card, .stats-bar { background-color: #141A2E !important; border-color: #0B0F1E !important; }
    .brand-title, .empty-title, .card-title { color: #F0EFEB !important; }
    .brand-meta, .empty-msg, .footer, .meta-label { color: #A0A8C8 !important; }
    .btn-ghost { color: #D4FF00 !important; border-color: #D4FF00 !important; }
  }
  @media (prefers-color-scheme: light) {
    body, .outer { background-color: #F0EFEB !important; }
    .card, .stats-bar { background-color: #FFFFFF !important; border-color: #0B0F1E !important; }
    .brand-title, .empty-title, .card-title { color: #0B0F1E !important; }
    .brand-meta, .empty-msg, .footer, .meta-label { color: #4A4A58 !important; }
    .btn-ghost { color: #0B0F1E !important; border-color: #0B0F1E !important; }
  }
</style>
</head>
<body class="outer" bgcolor="#0B0F1E" style="margin: 0; padding: 0; background-color: #0B0F1E; background-image: repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(212,255,0,0.05) 40px), repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(212,255,0,0.05) 40px); font-family: 'Space Grotesk', 'Trebuchet MS', 'Segoe UI', sans-serif; font-size: 14px; color: #F0EFEB; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: 100%;">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #0B0F1E;">
<tr>
<td align="center" style="padding: 24px 12px;">

<!-- Main content area: 600px max, centered -->
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; width: 100%; margin: 0 auto;">

<!-- ==================== HEADER ==================== -->
<tr>
<td style="padding: 0 0 16px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td width="52" valign="top" style="padding-right: 16px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td width="52" height="52" bgcolor="#D4FF00" align="center" valign="middle" style="background-color: #D4FF00; border: 2px solid #0B0F1E; box-shadow: 4px 4px 0 #FF4D00; width: 52px; height: 52px; text-align: center; vertical-align: middle; font-family: 'Unbounded', 'Arial Black', Impact, sans-serif; font-size: 18px; font-weight: 900; color: #0B0F1E; letter-spacing: -1px;">HD</td>
      </tr>
      </table>
    </td>
    <td valign="top">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td class="brand-title" style="padding: 0 0 4px 0; font-family: 'Unbounded', 'Arial Black', Impact, sans-serif; font-size: 26px; font-weight: 900; color: #F0EFEB; line-height: 1; letter-spacing: -1px; text-transform: uppercase; text-shadow: 2px 0 #FF4D00, -2px 0 #00FF41;">黑客松日报</td>
      </tr>
      <tr>
        <td class="brand-meta" style="padding: 0; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; color: #A0A8C8; letter-spacing: 0.12em; text-transform: uppercase;">{{ today }} &middot; 今日无新增</td>
      </tr>
      </table>
    </td>
  </tr>
  </table>
</td>
</tr>

<!-- TICKER -->
<tr>
<td style="padding: 0 0 18px 0; border-top: 2px solid #D4FF00; border-bottom: 2px solid #D4FF00;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding: 7px 0; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; color: #D4FF00; letter-spacing: 0.28em; text-transform: uppercase; white-space: nowrap; overflow: hidden;">HACKATHON // DAILY // 2026 // NO NEW ENTRIES // KEEP WATCHING //</td>
  </tr>
  </table>
</td>
</tr>

<!-- ==================== EMPTY STATE: contradiction pairing (serif + mono) ==================== -->
<tr>
<td style="padding: 0 0 26px 0;">
  <table class="stats-bar" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#380B44" style="background-color: #380B44; border: 2px solid #D4FF00; border-collapse: separate;">
  <tr>
    <td align="center" style="padding: 30px 20px;">
      <div style="font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; color: #D4FF00; letter-spacing: 0.3em; text-transform: uppercase;">STATUS / 00</div>
      <div class="empty-title" style="padding-top: 12px; font-family: 'Fraunces', Georgia, 'Times New Roman', serif; font-size: 34px; font-style: italic; font-weight: 700; color: #F0EFEB; line-height: 1; letter-spacing: -1px;">今日无新增</div>
      <div class="empty-msg" style="padding-top: 12px; font-size: 13px; color: #A0A8C8; line-height: 1.65;">今天没有发现新的可报名黑客松，明天见。</div>
      <div class="meta-label" style="padding-top: 16px; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; color: #A0A8C8; letter-spacing: 0.12em; text-transform: uppercase;">本周累计 {{ weekly_count }} 场</div>
    </td>
  </tr>
  </table>
</td>
</tr>

<!-- ==================== UPCOMING TOP3 ==================== -->
{% if top %}
<tr>
<td style="padding: 0 0 16px 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td bgcolor="#D4FF00" style="padding: 9px 12px; background-color: #D4FF00; border: 2px solid #0B0F1E; font-family: 'Unbounded', 'Arial Black', Impact, sans-serif; font-size: 15px; font-weight: 900; color: #0B0F1E; letter-spacing: -0.3px; text-transform: uppercase;">⏳ 即将截止 TOP3</td>
  </tr>
  </table>
</td>
</tr>

{% for h in top %}
{% set u = h.urgency() %}
{% set dl = h.days_left %}
<tr>
<td style="padding: 0 0 18px 0;">
  <table class="card" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#141A2E" style="background-color: #141A2E; border: 2px solid #0B0F1E; box-shadow: 5px 5px 0 #0B0F1E; border-collapse: separate;">
  <tr>
  <td style="padding: 16px 18px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td class="card-title" style="padding: 0; font-family: 'Unbounded', 'Arial Black', Impact, sans-serif; font-size: 16px; font-weight: 900; color: #F0EFEB; line-height: 1.15; letter-spacing: -0.4px;">{{ h.name }}</td>
      <td align="right" style="padding: 0 0 0 10px; white-space: nowrap;">
        {% if u == 'hot' %}
        <span style="display: inline-block; padding: 4px 8px; background-color: #FF4D00; border: 2px solid #0B0F1E; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; font-weight: 700; color: #FFFFFF; text-transform: uppercase;">{% if dl < 0 %}已截止{% elif dl == 0 %}今天截止{% else %}剩 {{ dl }} 天{% endif %}</span>
        {% elif u == 'soon' %}
        <span style="display: inline-block; padding: 4px 8px; background-color: #D4FF00; border: 2px solid #0B0F1E; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; font-weight: 700; color: #0B0F1E; text-transform: uppercase;">剩 {{ dl }} 天</span>
        {% elif u == 'later' %}
        <span style="display: inline-block; padding: 4px 8px; background-color: #00FF41; border: 2px solid #0B0F1E; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; font-weight: 700; color: #0B0F1E; text-transform: uppercase;">{{ dl }} 天后</span>
        {% else %}
        <span style="display: inline-block; padding: 4px 8px; background-color: #F0EFEB; border: 2px solid #0B0F1E; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 11px; font-weight: 700; color: #0B0F1E; text-transform: uppercase;">待定</span>
        {% endif %}
      </td>
    </tr>
    </table>
    <div class="meta-label" style="padding-top: 10px; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; color: #A0A8C8; letter-spacing: 0.1em; text-transform: uppercase;">报名截止 {{ h.registration_deadline }}</div>
    {% if h.register_link %}
    <a href="{{ h.register_link | safe_url }}" target="_blank" style="display: inline-block; margin-top: 12px; padding: 8px 18px; background-color: #D4FF00; border: 2px solid #0B0F1E; box-shadow: 3px 3px 0 #0B0F1E; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 12px; font-weight: 700; color: #0B0F1E; text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em;">立即报名 &rarr;</a>
    {% endif %}
  </td>
  </tr>
  </table>
</td>
</tr>
{% endfor %}
{% endif %}

<!-- ==================== FOOTER ==================== -->
<tr>
<td style="padding: 18px 0 0 0;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td style="padding: 0; border-top: 2px solid #D4FF00; font-size: 0; line-height: 0;">&nbsp;</td></tr>
  <tr>
    <td class="footer" style="padding: 16px 0 0 0; text-align: center; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 10px; color: #A0A8C8; text-transform: uppercase; letter-spacing: 0.14em; line-height: 1.6;">
      HACKATHON DAILY &middot; AUTO-DISPATCHED BY AI SEARCH &middot; NO. {{ today }}
    </td>
  </tr>
  </table>
</td>
</tr>

</table>
<!-- End main content -->

</td>
</tr>
</table>
<!-- End outer wrapper -->

</body>
</html>
