LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-search

# 多 Provider 容错：逗号分隔，顺序即优先级（默认仅 glm）
# 配置 openai 后需设 OPENAI_API_KEY，GLM 失败时自动 fallback
LLM_PROVIDERS=glm

# OpenAI 兼容 Provider（可选，作为 GLM fallback）
# 可接 DeepSeek/Kimi/通义等 OpenAI 兼容 API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

RESEND_API_KEY=
MAIL_FROM=Hackathon Daily <onboarding@resend.dev>
# 支持多收件人：逗号分隔
MAIL_TO=15720214985@163.com
