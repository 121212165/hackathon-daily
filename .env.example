# Provider key：LLM_API_KEY / GLM_API_KEY / OPENAI_API_KEY 至少配一个即可开跑
LLM_API_KEY=
# GLM_API_KEY=          # 与 LLM_API_KEY 等价（智谱 key 的别名）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-search

# LLM 内部顺序兜底链（可选，逗号分隔，默认 glm,openai）
# GLM 失败或返回空结果时自动 fallback 到 OpenAI 兼容源
LLM_PROVIDERS=glm,openai

# GLM 扇出查询条数（可选，默认 4；设为 1 即退回单查询现状）
LLM_FANOUT=4

# 顶层搜索源（可选，逗号分隔，默认 devpost,mlh,clist,serper,tavily,glm）
# "glm" 代表 LLM 兜底链（计费源，排最后）；留空 = 使用默认值
# 只想跑现状 LLM 单源时设为：SEARCH_SOURCES=glm
# SEARCH_SOURCES=devpost,mlh,clist,serper,tavily,glm

# 以下全部可选：未配置对应 key 的源自动跳过，不阻塞其它源
# 免费 SERP：Serper 2,500 次；Tavily 1,000 credits/月（用于召回，LLM 结构化）
SERPER_API_KEY=
TAVILY_API_KEY=
# clist.rocks 官方 JSON API（需免费注册）
CLIST_USERNAME=
CLIST_API_KEY=

# OpenAI 兼容 Provider（可选，作为 GLM fallback）
# 可接 DeepSeek/Kimi/通义等 OpenAI 兼容 API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

RESEND_API_KEY=
MAIL_FROM=Hackathon Daily <onboarding@resend.dev>
# 支持多收件人：逗号分隔
MAIL_TO=15720214985@163.com
